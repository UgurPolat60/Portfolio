# 512 MB of RAM, shared with PHP, Python and every visitor's demo database.
# MariaDB's defaults assume it owns the machine; these say otherwise.
[mysqld]
innodb_buffer_pool_size = 48M
innodb_log_file_size    = 16M
performance_schema      = OFF
max_connections         = 30
table_open_cache        = 200
tmp_table_size          = 8M
max_heap_table_size     = 8M
skip-name-resolve
